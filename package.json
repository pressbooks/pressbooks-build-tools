{
  "name": "pressbooks-build-tools",
  "version": "6.0.0",
  "description": "NPM package which includes all asset linting and build tools for Pressbooks projects.",
  "homepage": "https://github.com/pressbooks/pressbooks-build-tools#readme",
  "bugs": {
    "url": "https://github.com/pressbooks/pressbooks-build-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pressbooks/pressbooks-build-tools.git"
  },
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Pressbooks (Book Oven Inc.)",
    "email": "code@pressbooks.com",
    "url": "https://pressbooks.org/"
  },
  "main": "index.js",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./vite": "./config/vite.config.base.js",
    "./vite-wp": "./config/vite.config.wp.js",
    "./eslint": "./config/eslint.cjs",
    "./stylelint": "./config/stylelint.js"
  },
  "bin": {
    "pressbooks-build-tools": "./bin/cli.js"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "fix": "eslint --fix config/ assets/src/scripts/ index.js",
    "lint": "run-s lint:*",
    "lint:scripts": "eslint config/ assets/src/scripts/ index.js",
    "lint:styles": "stylelint assets/src/styles/",
    "test": "run-s lint:* build",
    "prepare": "husky install"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "eslintConfig": {
    "extends": "./config/eslint.cjs"
  },
  "stylelint": {
    "extends": "./config/stylelint.js"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@kucrut/vite-for-wp": "^0.12.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "autoprefixer": "^10.4.20",
    "babel-eslint": "^10.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsdoc": "^46.4.3",
    "eslint-plugin-sort-destructure-keys": "^1.4.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.3.5",
    "prettier-stylelint": "^0.4.2",
    "sass": "^1.92.1",
    "stylelint": "^14.10.0",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-recommended": "^9.0.0",
    "stylelint-config-standard-scss": "^6.0.0",
    "vite": "^7.1.5",
    "vite-plugin-live-reload": "^3.0.5",
    "vite-plugin-static-copy": "^3.1.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.3",
    "@commitlint/config-conventional": "^18.4.3",
    "husky": "^8.0.1",
    "lint-staged": "^14.0.1"
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.scss": "stylelint --fix"
  }
}
